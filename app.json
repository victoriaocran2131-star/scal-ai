{
  "expo": {
    "name": "Scal AI",
    "slug": "scal-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scalai",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a1a",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.scalai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scal AI needs camera access to scan food for nutrition analysis.",
        "NSPhotoLibraryUsageDescription": "Scal AI needs photo library access to upload food images.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.scalai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Scal AI to access your camera for food scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Scal AI to access your photos to upload food images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D4AF37"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69772cf5-a9b1-4b92-b684-88800dd2e130"
      }
    }
  }
}
