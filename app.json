{
  "expo": {
    "name": "Scal AI",
    "slug": "scai-fd8xk2026",
    "version": "1.0.26",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scalai",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.scalai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scal AI needs camera access to scan food for nutrition analysis.",
        "NSPhotoLibraryUsageDescription": "Scal AI needs photo library access to upload food images.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.scalai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Scal AI to access your camera for food scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Scal AI to access your photos to upload food images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D4AF37"
        }
      ],
      "expo-splash-screen"
    ],
    "owner": "samuelsparkss-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cac127d-35bd-4502-81f0-c3525abfadf6"
      }
    }
  }
}
