# Scal AI - Environment Variables
# Copy this file to .env and fill in your values

# Google Cloud Vision API Key (for AI food scanning)
# Get from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=your-google-vision-api-key

# USDA FoodData Central API Key (for nutrition data)
# Get from: https://api.data.gov/signup/ (free)
EXPO_PUBLIC_USDA_API_KEY=your-usda-api-key

# Firebase Config (required for app to function)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
